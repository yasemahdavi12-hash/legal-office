# Copy to `.env` and fill in values. Never commit `.env`.
PORT=3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# Database
# development: sqlite (default) | production: mysql (required)
# -----------------------------------------------------------------------------
DB_CLIENT=sqlite
DB_FILENAME=./database/legal.sqlite

# Production MySQL (set NODE_ENV=production and DB_CLIENT=mysql on the host)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=legal_app
DB_USER=legal_user
DB_PASSWORD=

# Optional non-production PostgreSQL (not supported for production in this release)
# DB_CLIENT=pg
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=
# DB_NAME=legal_app

# REQUIRED — min 32 characters each (no defaults in code)
JWT_ACCESS_SECRET=replace-with-long-random-access-secret-32+
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret-32+
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Comma-separated frontend origins. In production * is forbidden.
# In development, http://127.0.0.1:3000 is always allowed even if omitted here.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Public app URL for invitation links (defaults to http://localhost:PORT in development).
# Required in production — must be HTTPS (e.g. https://your-domain.com).
APP_PUBLIC_URL=http://localhost:3000
# INVITATION_TOKEN_TTL_DAYS=7

UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=20

# REQUIRED for admin seed (no hardcoded production credentials in repo)
ADMIN_EMAIL=admin@example.com
# Dev seed only — use a strong unique password in production
ADMIN_PASSWORD=your-strong-admin-password-here
ADMIN_NAME=مدیر سیستم

# Dev/test only — fixed 6-digit OTP for password-reset tests (ignored in production)
# OTP_TEST_FIXED=123456

# ZarinPal (official API v4) — never commit real merchant id
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL=http://localhost:3000/api/subscription/callback

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-domain.com
DEFAULT_TIMEZONE=Asia/Tehran
# REMINDER_POLL_MS=30000

# -----------------------------------------------------------------------------
# Security hardening / Production
# -----------------------------------------------------------------------------
# AES-256-GCM key for backups (+ MFA secret at rest if MFA_ENCRYPTION_KEY unset)
BACKUP_ENCRYPTION_KEY=replace-with-long-random-backup-key-32+
MFA_ENCRYPTION_KEY=

# Production MUST use s3. Development may use local.
BACKUP_STORAGE=local
BACKUP_RETENTION_COUNT=14
# BACKUP_KEEP_PLAINTEXT=false
# BACKUP_KEEP_LOCAL_ENC=true

# S3-compatible private storage (required when BACKUP_STORAGE=s3 / production)
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_BUCKET=legal-backups
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# Required in production for shared rate limiting
# REDIS_URL=redis://127.0.0.1:6379/0

# Soft-deleted documents permanent cleanup
DOCUMENT_SOFT_DELETE_RETENTION_DAYS=30
# DOCUMENT_CLEANUP_POLL_MS=21600000

# -----------------------------------------------------------------------------
# AI assistant (PRO only) — never commit real API keys
# Server does not crash if disabled or key missing; /api/ai/chat returns 503.
# -----------------------------------------------------------------------------
AI_ENABLED=false
AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_MAX_INPUT_CHARS=2000
# AI_MAX_OUTPUT_TOKENS=1024
# AI_MAX_CONTEXT_CHARS=4000
# AI_DAILY_LIMIT_PRO=50
